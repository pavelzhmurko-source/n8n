limit_req_zone $binary_remote_addr zone=telegram_webhook:10m rate=5r/s;

map $http_x_telegram_bot_api_secret_token $telegram_secret_valid {
    default 0;
    "__WEBHOOK_SECRET__" 1;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    client_max_body_size 1m;

    location = /webhook/telegram-course {
        limit_except POST {
            deny all;
        }

        if ($telegram_secret_valid = 0) {
            return 403;
        }

        limit_req zone=telegram_webhook burst=10 nodelay;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://n8n:5678;
    }

    location / {
        return 404;
    }
}
